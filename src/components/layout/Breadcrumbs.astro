---
export interface Crumb {
  name: string;
  /** Fehlt bei der aktuellen Seite */
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Brotkrumen-Navigation" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-muted">
    <li><a href="/" class="hover:text-navy-900 hover:underline">Startseite</a></li>
    {
      items.map((c) => (
        <li class="flex items-center gap-1.5">
          <span aria-hidden="true" class="text-gray-400">/</span>
          {c.href ? (
            <a href={c.href} class="hover:text-navy-900 hover:underline">
              {c.name}
            </a>
          ) : (
            <span aria-current="page" class="font-medium text-navy-900">
              {c.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
