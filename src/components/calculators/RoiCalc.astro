---
import CalculatorShell from '../calculator/CalculatorShell.astro';
import NumberField from '../calculator/NumberField.astro';
import ChoiceField from '../calculator/ChoiceField.astro';
import ResultMain from '../calculator/ResultMain.astro';
import ResultList from '../calculator/ResultList.astro';
const p = 'roi';
---

<CalculatorShell
  slug="roi"
  title="ROI berechnen"
  note="Der ROI berücksichtigt weder das Risiko noch den Zeitpunkt der Zahlungsflüsse. Für den Vergleich unterschiedlich langer Investitionen geben Sie die Dauer an – dann wird zusätzlich die durchschnittliche jährliche Rendite berechnet."
>
  <NumberField idPrefix={p} name="investment" label="Investitionssumme" value="10.000" suffix="€" hint="Alle Kosten der Investition, z. B. Kaufpreis plus Nebenkosten." />
  <ChoiceField
    idPrefix={p}
    name="mode"
    legend="Ich kenne …"
    value="total"
    options={[
      { value: 'total', label: 'den Gesamtrückfluss' },
      { value: 'profit', label: 'den Nettogewinn' },
    ]}
  />
  <div data-show-when="mode=total">
    <NumberField idPrefix={p} name="valueTotal" label="Gesamtrückfluss" value="12.500" suffix="€" hint="Alles, was zurückfließt – inklusive des eingesetzten Kapitals (z. B. Verkaufserlös)." />
  </div>
  <div data-show-when="mode=profit" hidden>
    <NumberField idPrefix={p} name="valueProfit" label="Nettogewinn" value="2.500" suffix="€" hint="Rückfluss minus Investition. Ein Verlust wird mit Minus eingegeben, z. B. −500." />
  </div>
  <NumberField idPrefix={p} name="years" label="Dauer der Investition" suffix="Jahre" optional placeholder="z. B. 2" decimals={2} />

  <Fragment slot="results">
    <ResultMain label="Return on Investment (ROI)" out="roi" stateKey="roi" />
    <ResultList
      items={[
        { label: 'Gewinn bzw. Verlust', out: 'profit', strong: true },
        { label: 'Gesamtrückfluss', out: 'total' },
        { label: 'Investitionssumme', out: 'investment' },
        { label: 'Ø Rendite pro Jahr', hint: 'nur mit Angabe der Dauer', out: 'annual' },
      ]}
    />
  </Fragment>
</CalculatorShell>

<script>
  import { mountCalculator } from '../../scripts/calc-runtime';
  import { calculateRoi } from '../../lib/calc/business';
  import { formatEUR, formatPercent } from '../../lib/format';

  mountCalculator('roi', (c) => {
    const mode = c.choice('mode') === 'profit' ? 'profit' : 'total';
    const valueField = mode === 'total' ? 'valueTotal' : 'valueProfit';
    const r = calculateRoi({ investment: c.num('investment'), mode, value: c.num(valueField), years: c.optional('years') });
    if (!r.ok) {
      const { value, ...rest } = r.errors;
      return { ...rest, [valueField]: value };
    }

    c.out('roi', formatPercent(r.roiPct));
    c.state('roi', r.roiPct < 0 ? 'negativ' : r.roiPct > 0 ? 'positiv' : '');
    c.out('profit', formatEUR(r.profit));
    c.out('total', formatEUR(r.totalReturn));
    c.out('investment', formatEUR(r.investment));
    c.out('annual', r.annualizedPct === null ? '–' : `${formatPercent(r.annualizedPct)} p. a.`);
    return null;
  });
</script>
