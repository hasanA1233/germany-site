---
/**
 * Rahmen für jeden Rechner: Eingaben links, Ergebnisse rechts (Desktop) bzw. untereinander (Mobil).
 * Slots:
 *  - default: Eingabefelder
 *  - "results": Ergebnisbereich (wird bei ungültigen Eingaben ausgeblendet)
 *  - "details": Tabellen/Diagramme unterhalb (volle Breite)
 */
import Icon from '../ui/Icon.astro';

interface Props {
  slug: string;
  title: string;
  /** Hinweis zu Annahmen unterhalb der Ergebnisse */
  note?: string;
}
const { slug, title, note } = Astro.props;
const headingId = `${slug}-heading`;
---

<section aria-labelledby={headingId} class="card overflow-hidden">
  <form data-calc={slug} novalidate class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div class="flex flex-col gap-5 p-5 sm:p-7">
      <h2 id={headingId} class="flex items-center gap-2 text-lg font-bold text-navy-900">
        <Icon name="calculator" size={22} class="text-brand-700" />
        {title}
      </h2>
      <slot />
      <p data-error-for="_form" class="text-sm font-medium text-danger-700" aria-live="polite" hidden></p>
      <div class="flex flex-wrap gap-3 pt-1">
        <button type="reset" class="btn-secondary">
          <Icon name="reset" size={18} />
          Zurücksetzen
        </button>
        <noscript>
          <p class="text-sm text-danger-700">Bitte aktivieren Sie JavaScript, um den Rechner zu nutzen.</p>
        </noscript>
      </div>
    </div>

    <div class="border-t border-line bg-navy-50/60 p-5 sm:p-7 lg:border-t-0 lg:border-l">
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-muted">Ergebnis</h3>
      <div data-results>
        <slot name="results" />
      </div>
      <div data-results-invalid hidden class="flex gap-3 rounded-xl border border-dashed border-gray-300 bg-card p-5 text-sm text-muted">
        <Icon name="info" size={20} class="shrink-0 text-navy-700" />
        <p>Bitte korrigieren Sie die markierten Eingaben. Das Ergebnis wird sofort neu berechnet.</p>
      </div>
      {note && <p class="mt-5 text-xs leading-relaxed text-muted">{note}</p>}
    </div>

    {
      Astro.slots.has('details') && (
        <div data-results class="border-t border-line p-5 sm:p-7 lg:col-span-2">
          <slot name="details" />
        </div>
      )
    }
  </form>
</section>
