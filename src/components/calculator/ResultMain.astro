---
/**
 * Hervorgehobenes Hauptergebnis – wird Screenreadern bei Änderung vorgelesen.
 * - labelOut: Schlüssel, um das Label dynamisch zu ändern
 * - stateKey: über ctx.state(stateKey, 'negativ'|'positiv') färbt sich die Box (z. B. Verlust = rot)
 */
interface Props {
  label: string;
  out: string;
  labelOut?: string;
  sub?: string;
  subOut?: string;
  stateKey?: string;
}
const { label, out, labelOut, sub, subOut, stateKey } = Astro.props;
---

<div
  class="result-box rounded-2xl p-5 transition-colors"
  data-state-for={stateKey}
  aria-live="polite"
  aria-atomic="true"
>
  <p class="result-label text-sm font-semibold" data-out={labelOut}>{label}</p>
  <p class="mt-1 text-3xl font-bold tracking-tight break-words tabular-nums sm:text-4xl" data-out={out}>–</p>
  {
    sub && (
      <p class="result-label mt-2 text-sm">
        {sub} <span class="font-semibold text-ink" data-out={subOut} />
      </p>
    )
  }
</div>
