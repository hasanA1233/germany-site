---
interface Props {
  id: string;
  title: string;
  legend: { color: string; label: string }[];
}
const { id, title, legend } = Astro.props;
---

<figure class="rounded-2xl border border-line bg-white p-4 sm:p-5">
  <figcaption class="mb-3 flex flex-wrap items-center justify-between gap-3">
    <span class="text-sm font-semibold text-navy-900">{title}</span>
    <span class="flex flex-wrap gap-4 text-xs text-muted">
      {
        legend.map((l) => (
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-block h-3 w-3 rounded-sm" style={`background:${l.color}`} aria-hidden="true" />
            {l.label}
          </span>
        ))
      }
    </span>
  </figcaption>
  <!-- Feste Seitenverhältnis-Box verhindert Layout-Verschiebungen -->
  <div data-chart={id} class="aspect-[640/260] w-full"></div>
</figure>
