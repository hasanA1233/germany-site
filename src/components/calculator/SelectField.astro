---
/** Auswahlliste mit Label oberhalb, Hinweis und Fehlermeldung – nutzt den Stil von field-input (appearance: none). */
interface Props {
  name: string;
  label: string;
  options: { value: string; label: string }[];
  value: string;
  idPrefix: string;
  hint?: string;
}
const { name, label, options, value, idPrefix, hint } = Astro.props;
const id = `${idPrefix}-${name}`;
const describedBy = [hint ? `${id}-hint` : null, `${id}-error`].filter(Boolean).join(' ');
---

<div class="flex flex-col gap-1.5">
  <label for={id} class="text-sm font-semibold text-navy-900">{label}</label>
  <select id={id} name={name} class="field-input min-h-11 pl-4" aria-describedby={describedBy}>
    {
      options.map((o) => (
        <option value={o.value} selected={o.value === value}>
          {o.label}
        </option>
      ))
    }
  </select>
  {hint && <p id={`${id}-hint`} class="text-xs leading-snug text-muted">{hint}</p>}
  <p id={`${id}-error`} data-error-for={name} class="text-sm font-medium text-danger-700" aria-live="polite" hidden></p>
</div>
