---
/**
 * Entgelttabelle (z. B. TVöD Anlage A) als responsive Tabelle:
 * horizontal scrollbar auf kleinen Bildschirmen, erste Spalte (Entgeltgruppe) bleibt stehen.
 */
interface Props {
  tabelle: Record<string, (number | null)[]>;
  reihenfolge: string[];
  caption: string;
}
const { tabelle, reihenfolge, caption } = Astro.props;
const eur = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---

<div class="not-prose my-6 overflow-x-auto rounded-2xl border border-line bg-card" tabindex="0" role="region" aria-label={caption}>
  <table class="w-full min-w-[40rem] border-collapse text-sm tabular-nums">
    <caption class="px-4 pt-3 pb-2 text-left text-sm font-semibold text-navy-900">{caption}</caption>
    <thead class="bg-surface text-navy-900">
      <tr>
        <th scope="col" class="sticky left-0 z-10 border-b border-line bg-surface px-3 py-2 text-left font-semibold">EG</th>
        {[1, 2, 3, 4, 5, 6].map((s) => <th scope="col" class="border-b border-line px-3 py-2 text-right font-semibold">Stufe {s}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        reihenfolge.map((eg) => (
          <tr class="border-b border-line last:border-b-0">
            <th scope="row" class="sticky left-0 z-10 bg-card px-3 py-2 text-left font-semibold text-navy-900 shadow-[1px_0_0_var(--border)]">
              E {eg}
            </th>
            {tabelle[eg].map((v) => (
              <td class="whitespace-nowrap px-3 py-2 text-right text-ink">{v == null ? '–' : `${eur(v)} €`}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
