---
import Icon from './Icon.astro';
import type { CalculatorMeta } from '../../data/calculators';
import { getCategory } from '../../data/categories';

interface Props {
  calc: CalculatorMeta;
  headingLevel?: 'h2' | 'h3';
  badge?: string;
}
const { calc, headingLevel = 'h3', badge } = Astro.props;
const Heading = headingLevel;
const category = getCategory(calc.category);
---

<article class="group card relative flex h-full flex-col p-5 transition-shadow hover:shadow-[var(--shadow-card-hover)] focus-within:shadow-[var(--shadow-card-hover)]">
  <div class="flex items-start justify-between gap-3">
    <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-brand-100">
      <Icon name={calc.icon} />
    </span>
    {badge && <span class="rounded-full bg-navy-50 px-2.5 py-1 text-xs font-semibold text-navy-800">{badge}</span>}
  </div>
  <Heading class="mt-4 text-base font-bold text-navy-900">
    <a href={calc.href} class="after:absolute after:inset-0 after:rounded-[var(--radius-card)] focus:outline-none">
      {calc.name}
    </a>
  </Heading>
  <p class="mt-1.5 flex-1 text-sm leading-relaxed text-muted">{calc.description}</p>
  <div class="mt-4 flex items-center justify-between text-xs font-medium">
    <span class="text-muted">{category.name}</span>
    <span class="inline-flex items-center gap-1 text-brand-700 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
      Öffnen <Icon name="arrow-right" size={16} />
    </span>
  </div>
</article>

<style>
  /* Fokusrahmen auf der ganzen Karte statt nur am Link */
  article:has(a:focus-visible) {
    outline: 3px solid var(--color-brand-600);
    outline-offset: 2px;
  }
</style>
