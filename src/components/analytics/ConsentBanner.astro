---
/**
 * Cookie-Banner mit Kategorien (Notwendig / Statistik / Marketing) und Google Consent Mode v2.
 * - Standardwerte „denied“ setzt BaseLayout.astro im <head>, bevor irgendein Google-Tag geladen wird.
 * - gtag.js wird ausschließlich nach Einwilligung in „Statistik“ geladen → vorher keine Anfragen an Google.
 * - „Alle akzeptieren“, „Nur notwendige“ und „Einstellungen“ sind gleichwertig gestaltet.
 * - [data-consent-settings] (Footer-Link „Cookie-Einstellungen“) öffnet den Banner erneut.
 * - Gespeichert wird nur die Auswahl selbst (localStorage, technisch erforderlich nach § 25 Abs. 2 Nr. 2 TDDDG).
 * - Ereignis „calculate“ (Parameter calculator_name) nur mit Einwilligung; keine Eingabewerte, keine personenbezogenen Daten.
 */
import { analyticsEnabled, gaMeasurementId, CONSENT_KEY, CONSENT_VERSION } from './analytics-config';
---

{
  analyticsEnabled && (
    <>
      <section
        id="consent-banner"
        class="card fixed inset-x-2 bottom-2 z-50 mx-auto max-h-[85vh] max-w-2xl overflow-y-auto p-4 shadow-2xl sm:inset-x-6 sm:bottom-6 sm:p-5"
        role="dialog"
        aria-modal="false"
        aria-labelledby="consent-title"
        aria-describedby="consent-text"
        hidden
      >
        <h2 id="consent-title" class="text-base font-bold text-navy-900 focus:outline-none" tabindex="-1">
          Datenschutz-Einstellungen
        </h2>
        <p id="consent-text" class="mt-2 text-[13px] leading-relaxed text-ink sm:text-sm">
          Wir möchten mit Google Analytics Nutzungsstatistiken erheben, um zu verstehen, welche Rechner hilfreich sind. Dafür werden Cookies gesetzt
          und Daten an Google übertragen – auch in die USA. Das geschieht nur mit Ihrer Einwilligung, die Sie jederzeit unter „Cookie-Einstellungen“
          widerrufen können. Ihre Eingaben in den Rechnern werden nicht übertragen. Mehr in der{' '}
          <a href="/datenschutz/#google-analytics" class="font-medium underline">
            Datenschutzerklärung
          </a>
          .
        </p>

        <fieldset id="consent-settings" class="mt-4 space-y-2" hidden>
          <legend class="sr-only">Cookie-Kategorien</legend>
          <label class="flex min-h-11 cursor-not-allowed items-start gap-3 rounded-xl bg-surface p-3">
            <input type="checkbox" checked disabled class="mt-1 h-5 w-5 shrink-0 accent-[var(--primary)]" />
            <span class="text-sm">
              <span class="block font-semibold text-navy-900">Notwendig (immer aktiv)</span>
              <span class="block text-muted">Speichert Ihre Auswahl in diesem Banner. Ohne diese Funktion kann die Website Ihre Entscheidung nicht beachten.</span>
            </span>
          </label>
          <label class="flex min-h-11 cursor-pointer items-start gap-3 rounded-xl bg-surface p-3">
            <input type="checkbox" name="statistik" class="mt-1 h-5 w-5 shrink-0 accent-[var(--primary)]" />
            <span class="text-sm">
              <span class="block font-semibold text-navy-900">Statistik (Google Analytics)</span>
              <span class="block text-muted">Anonymisierte Nutzungsstatistiken: welche Seiten und Rechner wie oft genutzt werden.</span>
            </span>
          </label>
          <label class="flex min-h-11 cursor-pointer items-start gap-3 rounded-xl bg-surface p-3">
            <input type="checkbox" name="marketing" class="mt-1 h-5 w-5 shrink-0 accent-[var(--primary)]" />
            <span class="text-sm">
              <span class="block font-semibold text-navy-900">Marketing (Google AdSense)</span>
              <span class="block text-muted">Personalisierte Werbung, mit der wir das kostenlose Angebot finanzieren. Derzeit werden keine Anzeigen ausgeliefert.</span>
            </span>
          </label>
          <button type="button" class="btn-secondary mt-2 w-full" data-consent="save">
            Auswahl speichern
          </button>
        </fieldset>

        <div class="mt-3 grid gap-2 sm:mt-4 sm:grid-cols-3">
          <button type="button" class="btn-secondary w-full" data-consent="all">
            Alle akzeptieren
          </button>
          <button type="button" class="btn-secondary w-full" data-consent="necessary">
            Nur notwendige
          </button>
          <button type="button" class="btn-secondary w-full" data-consent="settings" aria-expanded="false" aria-controls="consent-settings">
            Einstellungen
          </button>
        </div>
      </section>

      <script is:inline define:vars={{ gaId: gaMeasurementId, key: CONSENT_KEY, version: CONSENT_VERSION }}>
        (function () {
          var banner = document.getElementById('consent-banner');
          var settings = document.getElementById('consent-settings');
          var settingsBtn = banner.querySelector('[data-consent="settings"]');
          var gaLoaded = false;
          var current = read();

          function read() {
            try {
              var v = JSON.parse(localStorage.getItem(key) || 'null');
              return v && v.v === version ? { statistik: !!v.statistik, marketing: !!v.marketing } : null;
            } catch (e) {
              return null;
            }
          }
          function save(c) {
            try {
              localStorage.setItem(key, JSON.stringify({ v: version, statistik: c.statistik, marketing: c.marketing, at: new Date().toISOString() }));
            } catch (e) {}
          }
          function g(s) {
            return s ? 'granted' : 'denied';
          }
          function apply(c) {
            window.gtag('consent', 'update', {
              analytics_storage: g(c.statistik),
              ad_storage: g(c.marketing),
              ad_user_data: g(c.marketing),
              ad_personalization: g(c.marketing),
            });
            if (c.statistik) loadGa();
          }
          function loadGa() {
            if (gaLoaded) return;
            gaLoaded = true;
            window.gtag('js', new Date());
            // Datenschutzfreundlich: keine Google Signals, keine Werbepersonalisierung über Analytics
            window.gtag('config', gaId, { allow_google_signals: false, allow_ad_personalization_signals: false });
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
            document.head.appendChild(s);
          }
          function deleteGaCookies() {
            var host = location.hostname.replace(/^www\./, '');
            document.cookie.split(';').forEach(function (c) {
              var name = c.split('=')[0].trim();
              if (name === '_ga' || name.indexOf('_ga_') === 0) {
                ['', '; domain=' + host, '; domain=.' + host].forEach(function (d) {
                  document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
                });
              }
            });
          }
          function toggleSettings(open) {
            settings.hidden = !open;
            settingsBtn.setAttribute('aria-expanded', String(open));
            if (open) {
              var c = current || { statistik: false, marketing: false };
              settings.querySelector('[name="statistik"]').checked = c.statistik;
              settings.querySelector('[name="marketing"]').checked = c.marketing;
              settings.querySelector('[name="statistik"]').focus();
            }
          }
          function show(focus) {
            banner.hidden = false;
            toggleSettings(false);
            if (focus) banner.querySelector('#consent-title').focus();
          }
          function decide(c) {
            var previous = current;
            current = c;
            save(c);
            banner.hidden = true;
            if (previous && previous.statistik && !c.statistik) {
              // Widerruf: Cookies löschen und neu laden, damit gtag.js nicht weiterläuft
              window.gtag('consent', 'update', { analytics_storage: 'denied', ad_storage: g(c.marketing), ad_user_data: g(c.marketing), ad_personalization: g(c.marketing) });
              deleteGaCookies();
              location.reload();
              return;
            }
            apply(c);
          }

          banner.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-consent]');
            if (!btn) return;
            var action = btn.getAttribute('data-consent');
            if (action === 'all') decide({ statistik: true, marketing: true });
            else if (action === 'necessary') decide({ statistik: false, marketing: false });
            else if (action === 'settings') toggleSettings(settings.hidden);
            else if (action === 'save')
              decide({
                statistik: settings.querySelector('[name="statistik"]').checked,
                marketing: settings.querySelector('[name="marketing"]').checked,
              });
          });
          banner.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !settings.hidden) {
              toggleSettings(false);
              settingsBtn.focus();
            }
          });
          document.addEventListener('click', function (e) {
            if (e.target.closest('[data-consent-settings]')) {
              e.preventDefault();
              show(true);
            }
          });

          // Ereignis „calculate“: höchstens einmal pro Rechner und Minute, nur mit Einwilligung, ohne Eingabewerte
          var lastSent = {};
          document.addEventListener('qr:calculate', function (e) {
            if (!current || !current.statistik || !gaLoaded) return;
            var name = (e.detail && e.detail.calculator) || '';
            var now = Date.now();
            if (!name || (lastSent[name] && now - lastSent[name] < 60000)) return;
            lastSent[name] = now;
            window.gtag('event', 'calculate', { calculator_name: name });
          });

          if (current) apply(current);
          else show(false);
        })();
      </script>
    </>
  )
}
