---
/** Sichtbarer Platzhalter für die Layoutplanung – enthält bewusst KEINE Werbung. */
interface Props {
  label: string;
  minHeight: number;
}
const { label, minHeight } = Astro.props;
---

<div
  class="flex items-center justify-center rounded-2xl border-2 border-dashed border-gray-300 bg-surface text-center text-xs font-medium text-muted"
  style={`min-height:${minHeight}px`}
  aria-hidden="true"
>
  Anzeigenfläche (Platzhalter): {label}
</div>
