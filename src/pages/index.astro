---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/ui/SearchBox.astro';
import CalculatorCard from '../components/ui/CalculatorCard.astro';
import FaqList from '../components/ui/FaqList.astro';
import Icon from '../components/ui/Icon.astro';
import { calculators, calculatorsInCategory } from '../data/calculators';
import { categories } from '../data/categories';
import { site } from '../data/site';
import { formatDateDe } from '../lib/dates';

const featured = calculators.filter((c) => c.featured).slice(0, 6);
const popular = calculators
  .filter((c) => c.popular)
  .sort((a, b) => (a.popularRank ?? 99) - (b.popularRank ?? 99))
  .slice(0, 6);
const recentList = [...calculators].sort((a, b) => b.added.localeCompare(a.added)).slice(0, 4);

const guides = [
  {
    href: '/tilgungsrechner/#ratgeber',
    title: 'Tilgung verstehen: Warum eine höhere Tilgung zehntausende Euro spart',
    text: 'Wie Zinsbindung, anfängliche Tilgung und Restschuld zusammenhängen – mit Beispielrechnung für 300.000 €.',
    tag: 'Kredit & Finanzierung',
  },
  {
    href: '/zinseszins-rechner/#ratgeber',
    title: 'Der Zinseszinseffekt einfach erklärt',
    text: 'Warum Zeit der wichtigste Faktor beim Sparen ist und was die Regel von 72 aussagt.',
    tag: 'Sparen & Investieren',
  },
  {
    href: '/gewinnmarge-rechner/#ratgeber',
    title: 'Marge oder Aufschlag? Der Unterschied, der Ihre Preise bestimmt',
    text: 'Warum 25 % Aufschlag keine 25 % Marge ergeben – und wie Sie den richtigen Verkaufspreis berechnen.',
    tag: 'Business',
  },
  {
    href: '/umsatzsteuer-rechner/#ratgeber',
    title: 'Umsatzsteuer richtig herausrechnen',
    text: 'Der häufigste Fehler beim Rechnen mit Bruttobeträgen – und wie Sie ihn vermeiden.',
    tag: 'Gehalt & Steuern',
  },
];

const faq = [
  {
    q: 'Sind die Rechner von QuickRechner kostenlos?',
    a: 'Ja. Alle Rechner sind kostenlos und ohne Anmeldung nutzbar. Die Berechnung erfolgt direkt in Ihrem Browser.',
  },
  {
    q: 'Werden meine Eingaben gespeichert?',
    a: 'Nein. Die Berechnungen laufen vollständig in Ihrem Browser. Ihre eingegebenen Zahlen werden nicht an unseren Server übertragen und nicht gespeichert.',
  },
  {
    q: 'Wie genau sind die Ergebnisse?',
    a: 'Die Rechner verwenden die gängigen Formeln und nennen ihre Annahmen offen, zum Beispiel zur Zinsgutschrift oder zum Zahlungszeitpunkt. Banken und andere Anbieter können im Detail abweichend rechnen. Die Ergebnisse sind daher unverbindliche Orientierungswerte.',
  },
  {
    q: 'Ersetzen die Rechner eine Beratung?',
    a: 'Nein. Die Rechner helfen Ihnen, Zusammenhänge zu verstehen und Szenarien zu vergleichen. Für verbindliche Entscheidungen zu Krediten, Geldanlagen oder Steuern sollten Sie sich individuell beraten lassen.',
  },
  {
    q: 'Kann ich Zahlen im deutschen Format eingeben?',
    a: 'Ja. Sie können Beträge mit Tausenderpunkt und Dezimalkomma eingeben, zum Beispiel 25.000 oder 3,5. Auch die Eingabe mit Dezimalpunkt wird erkannt.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: `${site.url}/`,
    description: site.description,
    inLanguage: 'de-DE',
    publisher: { '@type': 'Organization', name: site.name, url: `${site.url}/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: `${site.url}/`,
    logo: `${site.url}/logo-512.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title="QuickRechner – Kostenlose Finanz- und Business-Rechner" rawTitle description={site.description} schema={schema}>
  <!-- Hero -->
  <section class="hero relative">
    <div class="container-page relative py-16 sm:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center gap-2 rounded-full bg-card/70 px-3 py-1 text-xs font-semibold tracking-wide text-brand-700 ring-1 ring-line">
          <Icon name="check" size={14} /> Kostenlos · Ohne Anmeldung · Berechnung im Browser
        </p>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-navy-900 sm:text-5xl lg:text-6xl">Finanzen einfach berechnen</h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft sm:text-xl">
          Kostenlose Online-Rechner für Kredite, Sparen, Investitionen, Steuern und Unternehmen.
        </p>
        <div class="mx-auto mt-8 max-w-xl text-ink">
          <SearchBox id="hero-search" size="lg" readQuery />
        </div>
        <div class="mt-6">
          <a href="#rechner" class="btn-primary">
            Rechner entdecken <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container-page">
    <!-- Featured -->
    <section id="rechner" class="scroll-mt-24 pt-16" aria-labelledby="featured-heading">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Ausgewählte Rechner</p>
          <h2 id="featured-heading" class="mt-1 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Die wichtigsten Finanzrechner</h2>
        </div>
        <a href="/finanzrechner/" class="inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:underline">
          Alle Rechner ansehen <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((c) => <CalculatorCard calc={c} />)}
      </div>
    </section>

    <!-- Categories -->
    <section class="pt-20" aria-labelledby="cat-heading">
      <p class="eyebrow">Kategorien</p>
      <h2 id="cat-heading" class="mt-1 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Rechner nach Thema</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((cat) => {
            const count = calculatorsInCategory(cat.id).length;
            return (
              <a href={cat.href} class="group card flex items-start gap-4 p-5 transition-shadow hover:shadow-[var(--shadow-card-hover)]">
                <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-brand-100">
                  <Icon name={cat.icon} />
                </span>
                <span>
                  <span class="block font-bold text-navy-900 group-hover:underline">{cat.name}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-muted">{cat.short}</span>
                  <span class="mt-2 block text-xs font-semibold text-brand-700">
                    {count} Rechner
                  </span>
                </span>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- Popular + Recently added -->
    <div class="grid gap-12 pt-20 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <section aria-labelledby="popular-heading">
        <p class="eyebrow">Beliebte Themen</p>
        <h2 id="popular-heading" class="mt-1 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Häufige Rechenfragen</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {popular.slice(0, 4).map((c) => <CalculatorCard calc={c} />)}
        </div>
      </section>
      <section aria-labelledby="recent-heading">
        <p class="eyebrow">Neu</p>
        <h2 id="recent-heading" class="mt-1 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Zuletzt hinzugefügt</h2>
        <ul class="mt-6 divide-y divide-line rounded-2xl border border-line bg-card">
          {
            recentList.map((c) => (
              <li>
                <a href={c.href} class="flex items-center gap-3 px-4 py-4 hover:bg-navy-50">
                  <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
                    <Icon name={c.icon} size={20} />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-semibold text-navy-900">{c.name}</span>
                    <span class="block text-xs text-muted">
                      Veröffentlicht am{' '}
                      <time datetime={c.added}>{formatDateDe(c.added, 'short')}</time>
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- Overview -->
    <section class="pt-20" aria-labelledby="overview-heading">
      <div class="grid gap-10 rounded-3xl bg-surface p-6 ring-1 ring-line sm:p-10 lg:grid-cols-2">
        <div>
          <p class="eyebrow">Finanz- und Business-Tools</p>
          <h2 id="overview-heading" class="mt-1 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Rechner, die erklären statt nur rechnen</h2>
          <p class="mt-4 leading-relaxed text-ink">
            Ein Ergebnis ist nur so gut wie das Verständnis dahinter. Deshalb zeigt jeder Rechner auf QuickRechner die verwendete Formel, nennt seine
            Annahmen und erklärt das Ergebnis an einem Beispiel. So können Sie die Zahlen nachvollziehen – und bessere Entscheidungen treffen.
          </p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            [
              { t: 'Private Finanzen', d: 'Kredite vergleichen, Tilgung planen, Sparziele durchrechnen.', l: '/kredit/' },
              { t: 'Geld anlegen', d: 'Zinseszins und Sparpläne mit klar benannten Annahmen.', l: '/sparen-investieren/' },
              { t: 'Selbstständigkeit', d: 'Gewinn, Marge und Umsatzsteuer für Angebote und Rechnungen.', l: '/business/' },
              { t: 'Kalkulation', d: 'Break-Even, ROI und Rabatte für Preisentscheidungen.', l: '/prozent-rechner/' },
            ].map((x) => (
              <li class="rounded-2xl bg-card p-5 ring-1 ring-line">
                <a href={x.l} class="font-semibold text-navy-900 hover:underline">
                  {x.t}
                </a>
                <p class="mt-1 text-sm text-muted">{x.d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Guides -->
    <section class="pt-20" aria-labelledby="guides-heading">
      <p class="eyebrow">Ratgeber</p>
      <h2 id="guides-heading" class="mt-1 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Wissen, das bei der Entscheidung hilft</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          guides.map((g) => (
            <article class="card relative p-6 transition-shadow hover:shadow-[var(--shadow-card-hover)]">
              <p class="text-xs font-semibold text-brand-700">{g.tag}</p>
              <h3 class="mt-2 text-lg font-bold text-navy-900">
                <a href={g.href} class="after:absolute after:inset-0">
                  {g.title}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{g.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- FAQ -->
    <div class="max-w-3xl pt-20">
      <FaqList items={faq} heading="Häufige Fragen zu QuickRechner" />
    </div>
  </div>
</BaseLayout>
