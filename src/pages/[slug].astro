---
/**
 * Vorlage für alle Rechnerseiten: /kreditrate-berechnen/, /zinseszins-rechner/, …
 * Inhalte: src/content/rechner/<slug>.md · Rechner: src/components/calculators/*
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/ui/FaqList.astro';
import RelatedCalculators from '../components/ui/RelatedCalculators.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import Icon from '../components/ui/Icon.astro';
import { getCalculator, type CalculatorSlug } from '../data/calculators';
import { getCategory } from '../data/categories';
import { site } from '../data/site';

import KreditrateCalc from '../components/calculators/KreditrateCalc.astro';
import ZinseszinsCalc from '../components/calculators/ZinseszinsCalc.astro';
import SparplanCalc from '../components/calculators/SparplanCalc.astro';
import TilgungCalc from '../components/calculators/TilgungCalc.astro';
import UmsatzsteuerCalc from '../components/calculators/UmsatzsteuerCalc.astro';
import GewinnCalc from '../components/calculators/GewinnCalc.astro';
import GewinnmargeCalc from '../components/calculators/GewinnmargeCalc.astro';
import RoiCalc from '../components/calculators/RoiCalc.astro';
import BreakEvenCalc from '../components/calculators/BreakEvenCalc.astro';
import RabattCalc from '../components/calculators/RabattCalc.astro';

const components: Record<CalculatorSlug, typeof KreditrateCalc> = {
  'kreditrate-berechnen': KreditrateCalc,
  'zinseszins-rechner': ZinseszinsCalc,
  'sparplan-rechner': SparplanCalc,
  tilgungsrechner: TilgungCalc,
  'umsatzsteuer-rechner': UmsatzsteuerCalc,
  'gewinn-rechner': GewinnCalc,
  'gewinnmarge-rechner': GewinnmargeCalc,
  'roi-rechner': RoiCalc,
  'break-even-rechner': BreakEvenCalc,
  'rabatt-rechner': RabattCalc,
};

export async function getStaticPaths() {
  const entries = await getCollection('rechner');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const meta = getCalculator(entry.id);
const category = getCategory(meta.category);
const Calculator = components[meta.slug];
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const data = entry.data;
const url = new URL(meta.href, site.url).href;
const updated = data.updated.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: meta.name,
    url,
    description: data.description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Alle (webbasiert)',
    browserRequirements: 'Erfordert JavaScript',
    inLanguage: 'de-DE',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  breadcrumbs={[{ name: category.name, href: category.href }, { name: meta.name }]}
  schema={schema}
  ogType="article"
  ogImage={`/og/${meta.slug}.png`}
  ogImageAlt={`${data.h1} – ${meta.name} von ${site.name} mit Formel: ${meta.ogFormula}`}
>
  <div class="container-page">
    <header class:list={['pt-6 pb-8', data.hero ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-center lg:gap-10' : 'max-w-3xl']}>
      <div class="max-w-3xl">
        <p class="eyebrow">{category.name}</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl">{data.h1}</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{data.intro}</p>
      </div>
      {/* Hero nur Desktop: Mobilgeräte erhalten das 1×1-Platzhalterbild und laden die Illustration nicht */}
      {
        data.hero && (
          <picture class="hidden lg:block">
            <source
              media="(min-width: 1024px)"
              type="image/webp"
              srcset={`/images/rechner/${data.hero.file}-600.webp 600w, /images/rechner/${data.hero.file}.webp 1200w`}
              sizes="24rem"
            />
            <img
              src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
              alt={data.hero.alt}
              width="1200"
              height="675"
              fetchpriority="high"
              decoding="async"
              class="h-auto w-full rounded-[var(--radius-card)] border border-line shadow-[var(--shadow-card)]"
            />
          </picture>
        )
      }
    </header>

    <Calculator />

    <AdSlot placement="after-results" />

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <article id="ratgeber" class="prose-qr min-w-0">
        <Content />

        {
          data.sources.length > 0 && (
            <>
              <h2 id="quellen">Quellen und Methodik</h2>
              <ul>
                {data.sources.map((s) => (
                  <li>
                    <a href={s.url} rel="noopener" target="_blank">
                      {s.label}
                      <span class="sr-only"> (externer Link, öffnet in neuem Tab)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        <p class="mt-10 text-sm text-muted">Zuletzt aktualisiert: <time datetime={data.updated.toISOString().slice(0, 10)}>{updated}</time></p>
      </article>

      <aside class="hidden lg:block" aria-label="Seitennavigation">
        <div class="sticky top-24 space-y-6">
          {
            toc.length > 0 && (
              <nav aria-labelledby="toc-heading" class="rounded-2xl border border-line p-5">
                <p id="toc-heading" class="text-sm font-semibold text-navy-900">
                  Auf dieser Seite
                </p>
                <ul class="mt-3 space-y-2 text-sm">
                  <li>
                    <a href="#inhalt" class="text-muted hover:text-navy-900">
                      Zum Rechner
                    </a>
                  </li>
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class="text-muted hover:text-navy-900">
                        {h.text}
                      </a>
                    </li>
                  ))}
                  <li>
                    <a href="#faq" class="text-muted hover:text-navy-900">
                      Häufige Fragen
                    </a>
                  </li>
                </ul>
              </nav>
            )
          }
          <AdSlot placement="sidebar" class="my-0" />
        </div>
      </aside>
    </div>

    <div class="mt-14 max-w-3xl">
      <FaqList items={data.faq} heading={`Häufige Fragen zum ${meta.name}`} />
    </div>

    <div class="mt-10 flex max-w-3xl gap-3 rounded-2xl border border-line bg-surface p-5 text-sm leading-relaxed text-muted">
      <Icon name="info" size={20} class="mt-0.5 shrink-0 text-navy-700" />
      <p>
        Alle Ergebnisse sind unverbindliche Berechnungen auf Basis Ihrer Eingaben und der genannten Annahmen. Sie ersetzen keine individuelle
        Finanz-, Steuer- oder Rechtsberatung. Mehr dazu im <a href="/haftungsausschluss/" class="font-medium text-navy-700 underline">Haftungsausschluss</a>.
      </p>
    </div>

    <AdSlot placement="before-related" />

    <div class="mt-14">
      <RelatedCalculators slugs={meta.related} />
    </div>
  </div>
</BaseLayout>
