---
/**
 * /prozent-rechner/ – Prozentrechner (Rechner + Ratgeber) und zugleich Kategorieseite „Prozent & Rabatt“.
 * Inhalt: src/content/rechner/prozent-rechner.mdx · Rechner: src/components/calculators/PercentCalc.astro
 */
import { getEntry } from 'astro:content';
import CalculatorPage from '../components/layout/CalculatorPage.astro';
import PercentCalc from '../components/calculators/PercentCalc.astro';
import CalculatorCard from '../components/ui/CalculatorCard.astro';
import { calculatorsInCategory } from '../data/calculators';

const entry = await getEntry('rechner', 'prozent-rechner');
if (!entry) throw new Error('Inhalt prozent-rechner.mdx fehlt');
const weitere = calculatorsInCategory('prozent-rechner').filter((c) => c.slug !== 'prozent-rechner');
---

<CalculatorPage entry={entry} breadcrumbs={[{ name: 'Prozentrechner' }]}>
  <PercentCalc />

  <section slot="after-calculator" aria-labelledby="weitere-heading" class="mt-14">
    <h2 id="weitere-heading" class="text-2xl font-bold tracking-tight text-navy-900">Weitere Prozent- &amp; Rabatt-Rechner</h2>
    <p class="mt-2 max-w-3xl text-muted">Für häufige Spezialfälle der Prozentrechnung gibt es eigene Rechner – mit passenden Formeln und Erklärungen.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {weitere.map((c) => <CalculatorCard calc={c} />)}
    </div>
  </section>
</CalculatorPage>
