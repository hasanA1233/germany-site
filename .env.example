# Kopieren Sie diese Datei nach .env und passen Sie die Werte an.
# Alle Variablen mit PUBLIC_ sind im Browser sichtbar – hier gehören KEINE Geheimnisse hinein.

# Google AdSense aktivieren (nur in Produktion wirksam). Standard: false
PUBLIC_ADS_ENABLED=false
# Ihre AdSense Publisher-ID, z. B. ca-pub-0000000000000000
PUBLIC_ADSENSE_CLIENT=

# Gestrichelte Platzhalter für Anzeigenflächen anzeigen (nur zur Layout-Planung). Standard: false
PUBLIC_SHOW_AD_PLACEHOLDERS=false
